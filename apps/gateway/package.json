{
  "name": "@lingobridge/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "dev:env": "node --env-file=.env --import tsx src/index.ts",
    "start": "node dist/index.js",
    "start:env": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google-cloud/translate": "10.0.1",
    "@hono/node-server": "2.1.1",
    "@lingobridge/contracts": "workspace:*",
    "hono": "4.13.7"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
