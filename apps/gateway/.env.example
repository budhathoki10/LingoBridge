# Safe local default. Live mode additionally requires exact extension origins,
# MYMEMORY_CONTACT_EMAIL, and NVIDIA_API_KEY.
LINGOBRIDGE_TRANSLATION_MODE=fake
HOST=127.0.0.1
PORT=8787

# Comma-separated exact origins, for example chrome-extension://<32-character-extension-id>.
LINGOBRIDGE_ALLOWED_EXTENSION_ORIGINS=

LINGOBRIDGE_PROVIDER_TIMEOUT_MS=10000
LINGOBRIDGE_RATE_WINDOW_MS=60000
LINGOBRIDGE_INSTALLATION_RATE_LIMIT=20
LINGOBRIDGE_NETWORK_RATE_LIMIT=30
LINGOBRIDGE_CAPABILITY_CACHE_PATH=.data/online-provider-capabilities.json
LINGOBRIDGE_CAPABILITY_FRESH_MS=86400000
LINGOBRIDGE_CAPABILITY_RETRY_MS=300000

# Required primary provider contact. MyMemory sends this as the `de` parameter on every request.
# Keep the real address in an ignored local env file or deployment configuration.
MYMEMORY_CONTACT_EMAIL=
MYMEMORY_BASE_URL=https://api.mymemory.translated.net
# Optional. MyMemory meters the free tier per IP address, so a shared host can
# exhaust the day's characters before your first request. A RapidAPI key moves
# that quota onto your account. Empty keeps the public endpoint.
MYMEMORY_RAPIDAPI_KEY=
# MyMemory's own private TM key, sent as the `key` parameter. Effect on the
# daily quota is undocumented; harmless when empty.
MYMEMORY_PRIVATE_KEY=
MYMEMORY_RAPIDAPI_HOST=mymemory-translation-memory1.p.rapidapi.com

# Required NVIDIA fallback key. Keep the real value in the deployment secret store or ignored
# local env file.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/riva-translate-4b-instruct-v2
NVIDIA_MAX_TOKENS=2048
NVIDIA_EXPLANATION_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_EXPLANATION_MAX_TOKENS=4096
LINGOBRIDGE_EXPLANATION_TIMEOUT_MS=90000
# How long NVIDIA may take before the OpenRouter backup is asked instead.
LINGOBRIDGE_EXPLANATION_PRIMARY_TIMEOUT_MS=20000

# Optional backup for Explain and word understanding when NVIDIA fails or is slow. Leave the key
# empty to disable it. Keep the real key in an ignored local env file or deployment secrets.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nex-agi/nex-n2.5-pro:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional Google capability metadata. This is an identifier, not a credential. The Cloud
# Translation API must be enabled when live capability metadata is used.
GOOGLE_CLOUD_PROJECT=

# Provider credential files are never written here. Live Google authentication
# uses Application Default Credentials supplied by the deployment environment.

# "Explain" uses the same NVIDIA_API_KEY as fallback translation.
