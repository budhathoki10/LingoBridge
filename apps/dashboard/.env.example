# Local Google sign-in. Copy to apps/dashboard/.env.local (ignored by git) and fill in the values.
# Without this file the dashboard uses the development sign-in, which accepts any email.

LINGOBRIDGE_AUTH_MODE=oidc

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID → Web application.
# Authorized redirect URI: http://127.0.0.1:3000/auth/callback
OIDC_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
OIDC_CLIENT_SECRET=YOUR_CLIENT_SECRET

# Keeps you signed in across dashboard restarts. Any random value of at least 32 characters.
LINGOBRIDGE_SESSION_SECRET=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
