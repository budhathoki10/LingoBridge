{
  "name": "lingobridge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "dev:dashboard": "pnpm --filter @lingobridge/dashboard dev",
    "dev:extension": "pnpm --filter @lingobridge/extension dev",
    "dev:gateway": "pnpm --filter @lingobridge/gateway dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "biome lint .",
    "test": "pnpm --filter @lingobridge/tests test",
    "typecheck": "pnpm --filter @lingobridge/contracts build && pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "sharp": "0.35.4",
    "typescript": "5.9.3"
  }
}
